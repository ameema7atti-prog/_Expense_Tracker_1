from IPython.display import HTML

html_code = """
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body style="margin: 0; background-color: #ffffff;">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef, useMemo, useCallback } = React;

    function ExpenseTracker() {
      const [expenses, setExpenses] = useState([]);
      const [description, setDescription] = useState('');
      const [amount, setAmount] = useState('');
      const [category, setCategory] = useState('Food');
      const inputRef = useRef(null);

      useEffect(() => {
        const fetchMockExpenses = async () => {
          const mockData = [
            { id: 1, description: 'Groceries', amount: 45.5, category: 'Food' },
            { id: 2, description: 'Internet Bill', amount: 60.0, category: 'Utilities' }
          ];
          setExpenses(mockData);
        };
        fetchMockExpenses();
      }, []);

      const handleFocus = () => {
        if (inputRef.current) inputRef.current.focus();
      };

      const handleDelete = useCallback((id) => {
        setExpenses((prev) => prev.filter((item) => item.id !== id));
      }, []);

      const totalExpense = useMemo(() => {
        return expenses.reduce((sum, item) => sum + item.amount, 0);
      }, [expenses]);

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!description || !amount) return;

        const newExpense = {
          id: Date.now(),
          description,
          amount: parseFloat(amount),
          category
        };

        setExpenses((prev) => [...prev, newExpense]);
        setDescription('');
        setAmount('');
        handleFocus();
      };

      return (
        <div style={{ maxWidth: '500px', margin: '20px auto', fontFamily: 'sans-serif', padding: '20px', border: '1px solid #ddd', borderRadius: '8px' }}>
          <h2>Expense Tracker</h2>
          <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
            <input
              ref={inputRef}
              type="text"
              placeholder="Description"
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              style={{ padding: '8px' }}
            />
            <input
              type="number"
              placeholder="Amount"
              value={amount}
              onChange={(e) => setAmount(e.target.value)}
              style={{ padding: '8px' }}
            />
            <select value={category} onChange={(e) => setCategory(e.target.value)} style={{ padding: '8px' }}>
              <option value="Food">Food</option>
              <option value="Utilities">Utilities</option>
              <option value="Entertainment">Entertainment</option>
            </select>
            <button type="submit" style={{ padding: '10px', backgroundColor: '#007bff', color: '#fff', border: 'none', borderRadius: '4px', cursor: 'pointer' }}>
              Add Expense
            </button>
          </form>

          <h3>Total: ${totalExpense.toFixed(2)}</h3>

          <ul style={{ listStyle: 'none', padding: 0 }}>
            {expenses.map((item) => (
              <li key={item.id} style={{ display: 'flex', justifyContent: 'space-between', padding: '8px 0', borderBottom: '1px solid #eee' }}>
                <span>{item.description} ({item.category}): ${item.amount.toFixed(2)}</span>
                <button onClick={() => handleDelete(item.id)} style={{ color: 'red', border: 'none', background: 'none', cursor: 'pointer' }}>
                  Delete
                </button>
              </li>
            ))}
          </ul>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<ExpenseTracker />);
  </script>
</body>
</html>
"""

# Render inside an iframe cell in Colab
HTML(f'<iframe srcdoc="{html_code.replace('"', '&quot;')}" width="100%" height="500px" style="border:none;"></iframe>')
